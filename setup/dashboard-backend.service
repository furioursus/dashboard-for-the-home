# System-level unit: starts the FastAPI backend on boot and keeps it
# running. Install to /etc/systemd/system/dashboard-backend.service.
#
# Runs as the `pi` user against the venv setup.sh creates. Edit
# WorkingDirectory/User/paths if you cloned the repo somewhere else or
# use a different account.

[Unit]
Description=Office Pi Dashboard backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/dashboard-for-the-home/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/dashboard-for-the-home/backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 5000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
