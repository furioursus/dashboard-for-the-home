# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real secrets.
#
# Everything here is either a secret or machine-specific network info.
# Room-specific but non-secret settings (Hue group ID, display names,
# poll intervals) live in config.yaml instead.

# --- Todoist ---------------------------------------------------------
# Settings -> Integrations -> Developer -> "API token"
TODOIST_API_TOKEN=

# --- Calendar (CalDAV) ------------------------------------------------
# Fastmail (primary path):
#   URL:      https://caldav.fastmail.com/dav/calendars/user/YOUR_EMAIL/
#   Username: your Fastmail email address
#   Password: an app password with Calendar access
#             (Settings -> Privacy & Security -> Integrations -> App passwords)
#
# iCloud (stretch-goal alternative - same CalDAV code path, just point it
# here instead. Needs an app-specific password from appleid.apple.com,
# Sign-In and Security -> App-Specific Passwords):
#   URL:      https://caldav.icloud.com
#   Username: your Apple ID email
#   Password: the app-specific password
CALDAV_URL=https://caldav.fastmail.com/dav/calendars/user/you@example.com/
CALDAV_USERNAME=
CALDAV_APP_PASSWORD=

# --- Hue -------------------------------------------------------------
# Bridge's local IP (Settings app on the bridge, your router's DHCP list,
# or https://discovery.meethue.com/). The API key comes from the one-time
# press-link pairing flow - see README / setup/pair_hue.py.
HUE_BRIDGE_IP=
HUE_API_KEY=

# --- Bambu P1S ---------------------------------------------------------
# Printer must have LAN Only Mode enabled (Settings -> WLAN on the
# touchscreen). Access code and serial are shown on that same screen.
BAMBU_IP=
BAMBU_ACCESS_CODE=
BAMBU_SERIAL=
